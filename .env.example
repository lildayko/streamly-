# YouTube Data API v3 — Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_API_KEY=

# Twitch Developer Console -> Your App
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# VK API access token with permission to search videos (keep private)
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199

# OAuth для подключения личного YouTube-аккаунта (Google Cloud -> OAuth client ID)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Должен совпадать с redirect URI в Google Cloud; для локального запуска:
YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback

# Add this exact URL to OAuth Redirect URLs in your Twitch Developer Console app.
TWITCH_REDIRECT_URI=http://localhost:3000/api/twitch/callback
